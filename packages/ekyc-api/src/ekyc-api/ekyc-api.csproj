<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <AWSProjectType>Lambda</AWSProjectType>
        <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <StartupObject>ekyc_api.LocalEntryPoint</StartupObject>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\ekyc-api.xml</DocumentationFile>
        <PackageVersion>0.1.0</PackageVersion>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <FileVersion>0.1.0</FileVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Amazon.AspNetCore.Identity.Cognito" Version="3.0.0" />
        <PackageReference Include="Amazon.Lambda.AspNetCoreServer" Version="9.2.1" />
        <PackageReference Include="Amazon.Lambda.Logging.AspNetCore" Version="4.1.1" />
        <PackageReference Include="AWS.Logger.AspNetCore" Version="3.5.3" />
        <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.512.1" />
        <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.7" />
        <PackageReference Include="AWSSDK.Rekognition" Version="3.7.502.45" />
        <PackageReference Include="AWSSDK.S3" Version="3.7.510.11" />
        <PackageReference Include="AWSSDK.SageMaker" Version="3.7.529.6" />
        <PackageReference Include="AWSSDK.SageMakerRuntime" Version="3.7.502.2" />
        <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.502.48" />
        <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.505.2" />
        <PackageReference Include="AWSSDK.Textract" Version="3.7.502.42" />
        <PackageReference Include="AWSXRayRecorder.Handlers.AspNetCore" Version="2.13.0" />
        <PackageReference Include="AWSXRayRecorder.Handlers.AwsSdk" Version="2.14.0" />
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="Hellang.Middleware.ProblemDetails" Version="6.5.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.24" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.24" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="RestSharp" Version="113.1.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.4" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="DocumentDefinitions\MY-NRIC\postcodes.csv"/>
        <Content Include="DocumentDefinitions\MY-NRIC\postcodes.csv">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="states.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="DocumentDefinitions\documentdefinitions.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Remove="DocumentDefinitions\textract.sh"/>
        <Content Include="DocumentDefinitions\textract.sh">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Remove="Dockerfile"/>
        <Content Include="Dockerfile">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>